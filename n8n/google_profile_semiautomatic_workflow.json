{
  "name": "01 Google profile - Semi-automatic setup (Codex assisted)",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Start manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-640, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "codex_assisted",
              "name": "codex_assisted",
              "type": "boolean",
              "value": false
            },
            {
              "id": "wait_seconds",
              "name": "wait_seconds",
              "type": "number",
              "value": 300
            },
            {
              "id": "storage_state",
              "name": "storage_state",
              "type": "string",
              "value": "={{$env.GOOGLE_MAPS_STORAGE_STATE}}"
            }
          ]
        },
        "options": {}
      },
      "id": "edit-profile-settings",
      "name": "Edit profile settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "command": "=powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{$env.BRIGHTDATA_ELT_ROOT}}\\n8n\\setup_google_login.ps1\" -StorageState \"{{$json.storage_state}}\" -WaitSeconds {{$json.wait_seconds}} {{$json.codex_assisted ? '-CodexAssisted' : ''}}"
      },
      "id": "create-google-profile",
      "name": "Create Google login profile",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [-140, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "message",
              "name": "message",
              "type": "string",
              "value": "=Googleログイン状態を保存しました。storage_state={{$node[\"Edit profile settings\"].json.storage_state}}"
            },
            {
              "id": "stdout",
              "name": "stdout",
              "type": "string",
              "value": "={{$json.stdout}}"
            },
            {
              "id": "stderr",
              "name": "stderr",
              "type": "string",
              "value": "={{$json.stderr}}"
            }
          ]
        },
        "options": {}
      },
      "id": "completion-summary",
      "name": "Completion summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [120, 0]
    }
  ],
  "connections": {
    "Start manually": {
      "main": [[{"node": "Edit profile settings", "type": "main", "index": 0}]]
    },
    "Edit profile settings": {
      "main": [[{"node": "Create Google login profile", "type": "main", "index": 0}]]
    },
    "Create Google login profile": {
      "main": [[{"node": "Completion summary", "type": "main", "index": 0}]]
    }
  },
  "settings": {"executionOrder": "v1"},
  "pinData": {},
  "staticData": null,
  "tags": []
}
